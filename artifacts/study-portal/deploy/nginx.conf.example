server {
    listen 80;
    server_name example.com;

    # Serve the built Study Portal files from this directory.
    root /var/www/study-portal;
    index index.html;

    # Forward only the app's own API routes to its Node.js backend.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static assets and let the client-side app handle page routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
